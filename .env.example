# Copie para .env. Tudo é opcional, exceto a chave da OpenAI quando algum provider for "openai".

# --- Providers: openai | local ---------------------------------------------
# local = whisper.cpp em Docker (ver README)
TRANSCRIPTION_PROVIDER=openai
# local = whisper.cpp + LLM no llama.cpp em Docker (ver README)
TRANSLATION_PROVIDER=openai

# --- OpenAI -------------------------------------------------------------------
# Obrigatória para os providers "openai" e para o modo Perguntar
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate
OPENAI_SOURCE_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_CHAT_MODEL=gpt-6.1-sol

# --- Local (Docker) -------------------------------------------------------------
LOCAL_WHISPER_URL=http://localhost:8080
# Arquivo em docker/whisper/models/ggml-<modelo>.bin (large-v3-turbo, large-v3, medium...)
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_LLM_URL=http://localhost:8081
# repo:quant da Hugging Face, baixado pelo llama.cpp na primeira execução
LOCAL_LLM_MODEL=ggml-org/gemma-3-4b-it-GGUF:Q4_K_M

# --- Outros ---------------------------------------------------------------------
# Onde ficam as sessões (padrão: ./data)
# DATA_DIR=data
# 1 = loga chunks/s e RMS do áudio a cada segundo (diagnóstico da captura)
# LOG_AUDIO_LEVELS=1
